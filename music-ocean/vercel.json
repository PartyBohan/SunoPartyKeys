{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "functions": {"api/suno-bridge.ts":{"maxDuration":60}},
  "rewrites": [
    {"source":"/s/:token","destination":"https://suno.popumusic.cn/s/:token"},
    {"source":"/api/cards","destination":"https://suno.popumusic.cn/api/cards"},
    {"source":"/api/cards/:path*","destination":"https://suno.popumusic.cn/api/cards/:path*"},
    {"source":"/api/auth/:path*","destination":"https://suno.popumusic.cn/api/auth/:path*"},
    {"source":"/api/providers","destination":"https://suno.popumusic.cn/api/providers"},
    {"source":"/api/providers/:path*","destination":"https://suno.popumusic.cn/api/providers/:path*"},
    {"source":"/api/jobs","destination":"https://suno.popumusic.cn/api/jobs"},
    {"source":"/api/jobs/:path*","destination":"https://suno.popumusic.cn/api/jobs/:path*"},
    {"source":"/api/account","destination":"https://suno.popumusic.cn/api/account"},
    {"source":"/api/health","destination":"https://suno.popumusic.cn/api/health"},
    {"source":"/api/upload","destination":"https://suno.popumusic.cn/api/upload"},
    {"source":"/api/generate","destination":"https://suno.popumusic.cn/api/generate"},
    {"source":"/api/work","destination":"https://suno.popumusic.cn/api/work"}
  ],
  "headers": [{"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"private, no-store"}]}]
}
