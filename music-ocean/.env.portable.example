# Inject a unique random secret through the server environment; never commit its value.
OCEAN_COOKIE_SECRET=
OCEAN_AUTH_MODE=suno
PUBLIC_ORIGIN=https://suno.popumusic.cn
OCEAN_ALLOWED_ORIGINS=https://suno.popumusic.cn,https://suno.partykeys.ai
SUNO_CLIENT_ID=
SUNO_PARTYKEYS_CLIENT_ID=
OCEAN_DATA_DIR=/var/lib/music-ocean
HOST=127.0.0.1
PORT=8787
NODE_ENV=production
